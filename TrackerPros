	btn.AutoButtonColor = false
	btn.Parent = parent
	makeCorner(btn, 8)

	local baseColor = color
	local hoverColor = Color3.new(
		math.min(baseColor.R + 0.08, 1),
		math.min(baseColor.G + 0.08, 1),
		math.min(baseColor.B + 0.08, 1)
	)

	btn.MouseEnter:Connect(function() btn.BackgroundColor3 = hoverColor end)
	btn.MouseLeave:Connect(function() btn.BackgroundColor3 = baseColor end)
	btn.MouseButton1Click:Connect(callback)
	return btn
end

