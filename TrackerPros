	local function refresh(animate)
		local trackGoal = active and accentColor or C.cardAlt
		local knobPos = active and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
		local knobColor = active and Color3.new(1, 1, 1) or C.textFaint
