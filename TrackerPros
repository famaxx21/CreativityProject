-- Main loop ---------------------------------------------------------------

local function initializeScript()
	buildUi()

	task.spawn(function()
		while task.wait(POLL_INTERVAL) do
			local now = os.clock()
			local money = getMoney()

			if money and not sessionBaseline then
				sessionBaseline = money
				sessionBaselineSetAt = now
			end
			if money and now - sessionBaselineSetAt >= SESSION_RESET_INTERVAL then
				sessionBaseline = money
				sessionBaselineSetAt = now
			end

			local profit = (money and sessionBaseline) and (money - sessionBaseline) or 0

			if moneyValue then
				moneyValue.Text = money and ("$" .. commaFormat(money)) or "$--"
			end
			if profitValue then
				if not money then
					profitValue.Text = "--"
					profitValue.TextColor3 = C.textDim
				elseif profit > 0 then
					profitValue.Text = "+$" .. commaFormat(profit)
					profitValue.TextColor3 = C.green
				elseif profit < 0 then
					profitValue.Text = "-$" .. commaFormat(-profit)
					profitValue.TextColor3 = C.red
				else
					profitValue.Text = "$0"
					profitValue.TextColor3 = C.textDim
				end
			end

			local current, max = readInventory()
			if inventoryValue then
				if current and max then
					inventoryValue.Text = tostring(current) .. "/" .. tostring(max)
					inventoryValue.TextColor3 = (current >= max * SELL_THRESHOLD) and C.amber or C.green
				else
					inventoryValue.Text = "--/--"
				end
			end

			if autoSell and current and max then
				local full = current >= max * SELL_THRESHOLD
				if full then
					if not sellArmedAt then
						sellArmedAt = now
					elseif now - sellArmedAt >= SELL_DELAY and now - lastSellTime >= SELL_COOLDOWN then
						lastSellTime = now
						sellArmedAt = nil
						if sellAll() then
							sellCount = sellCount + 1
							if sellCountLabel then sellCountLabel.Text = tostring(sellCount) end
						end
					end
				else
					sellArmedAt = nil
				end
			else
				sellArmedAt = nil
			end
		end
	end)

	task.spawn(function()
		while task.wait(NPC_SCAN_INTERVAL) do
			pcall(scanNpcEsp)
		end
	end)

	task.spawn(function()
		while task.wait(TOTEM_SCAN_INTERVAL) do
			pcall(scanTotems)
		end
	end)

	task.spawn(function()
		runService.RenderStepped:Connect(function()
			pcall(updateTracers)
		end)
	end)

	task.spawn(function()
		while task.wait(0.1) do
			pcall(runJumpTick)
		end
	end)
end

xpcall(initializeScript, function(err)
	warn("Failed to initialize.")
	warn(err)
	warn(debug.traceback())
end)
