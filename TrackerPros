			tweenService:Create(track, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { BackgroundColor3 = trackGoal }):Play()
			tweenService:Create(knob, TweenInfo.new(0.15, Enum.EasingStyle.Quad), { Position = knobPos, BackgroundColor3 = knobColor }):Play()
		else
			track.BackgroundColor3 = trackGoal
			knob.Position = knobPos
			knob.BackgroundColor3 = knobColor
		end
	end

