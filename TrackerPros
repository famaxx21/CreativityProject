-- Parsing ------------------------------------------------------------------

local function stripRichText(text)
	return (text:gsub("<[^>]->", ""))
end

local function parseMoney(raw)
	if not raw or #raw == 0 then return nil end
	local text = stripRichText(raw):gsub("^%s+", ""):gsub("%s+$", "")
	if text:sub(1, 1) == "+" or text:sub(1, 1) == "-" then return nil end
	if text:sub(1, 1) ~= "$" then return nil end
	local numStr = text:match("^%$([%d,]+)$")
	return numStr and tonumber((numStr:gsub(",", ""))) or nil
end

local function parseRatio(raw)
	if not raw then return nil, nil end
	local currentStr = (raw:match("^(%d+)%s*/%s*%d+$"))
	local maxStr = (raw:match("^%d+%s*/%s*(%d+)$"))
	return currentStr and tonumber(currentStr) or nil,
	       maxStr and tonumber(maxStr) or nil
end

local function commaFormat(n)
	local neg = n < 0
	local s = tostring(math.floor(math.abs(n)))
	local k
	repeat
		s, k = s:gsub("^(%d+)(%d%d%d)", "%1,%2")
	until k == 0
	return (neg and "-" or "") .. s
end

-- Detection ----------------------------------------------------------------

local function getMoney()
	if cachedMoneyLabel and cachedMoneyLabel.Parent then
		local c = parseMoney(cachedMoneyLabel.Text)
		if c then return c end
	end
	local playerGui = getPlayerGui()
	if not playerGui then return nil end
	local best, bestVal
	for _, d in ipairs(playerGui:GetDescendants()) do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			local m = parseMoney(d.Text)
			if m and (not bestVal or m > bestVal) then
				best, bestVal = d, m
			end
		end
	end
	if best then
		cachedMoneyLabel = best
		return bestVal
	end
	return nil
end

local function resolvePath(root, path)
	local current = root
	for _, name in ipairs(path) do
		if not current then return nil end
		current = current:FindFirstChild(name)
	end
	return current
end

local function locateInventoryLabel()
	local playerGui = getPlayerGui()
	if not playerGui then return nil end
	for _, path in ipairs(INVENTORY_LABEL_PATHS) do
		local label = resolvePath(playerGui, path)
		if label and label:IsA("TextLabel") then
			local c, m = parseRatio(label.Text)
			if c and m then return label end
		end
	end
	return nil
end

local function readInventory()
	if cachedInventoryLabel and cachedInventoryLabel.Parent then
		local c, m = parseRatio(cachedInventoryLabel.Text)
		if c and m then return c, m end
	end
	local label = locateInventoryLabel()
	if not label then return nil, nil end
	cachedInventoryLabel = label
	return parseRatio(label.Text)
end

local function resolveSellRemote()
	if cachedSellRemote and cachedSellRemote.Parent then
		return cachedSellRemote
	end
	local remote = resolvePath(replicatedStorage, SELL_REMOTE_PATH)
	if remote then cachedSellRemote = remote end
	return remote
end

local function sellAll()
	local remote = resolveSellRemote()
	if not remote then return false end
	return pcall(function()
		if remote:IsA("RemoteFunction") then
			remote:InvokeServer()
		else
			remote:FireServer()
		end
	end)
end

-- NPC detection ------------------------------------------------------------

local function isPlayerCharacter(model)
	for _, player in ipairs(playersService:GetPlayers()) do
		if player.Character == model then
			return true
		end
	end
	return false
end

local function isNpc(model)
	if not model:IsA("Model") then return false end
	if isPlayerCharacter(model) then return false end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then return false end
	if humanoid.Health <= 0 then return false end
	local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
	if not hrp then return false end
	return true
end

local function getNpcAnchor(model)
	return model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Head")
end

local function getNpcHeadTop(model)
	local head = model:FindFirstChild("Head")
	if head then
		return head.Position + Vector3.new(0, head.Size.Y / 2 + 1.5, 0)
	end
	local hrp = model:FindFirstChild("HumanoidRootPart")
	if hrp then
		return hrp.Position + Vector3.new(0, 3, 0)
	end
	return nil
end

local function getNpcDisplayName(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.DisplayName and humanoid.DisplayName ~= "" then
		return humanoid.DisplayName
	end
	return model.Name
end

-- NPC ESP ------------------------------------------------------------------

local function createTracer()
	local line = Drawing.new("Line")
	line.Thickness = 1.5
	line.Color = NPC_TRACER_COLOR
	line.Transparency = 1
	line.Visible = false
	return line
end

local function createNameTag()
	local text = Drawing.new("Text")
	text.Size = 14
	text.Center = true
	text.Outline = true
	text.OutlineColor = Color3.new(0, 0, 0)
	text.Color = NPC_NAME_COLOR
	text.Font = Drawing.Fonts.UI
	text.Visible = false
	return text
end

local function ensureNpcEsp(npc)
	local data = trackedNpcs[npc]
	if not data then
		data = {}
		trackedNpcs[npc] = data
	end

	if npcHighlightEnabled and not data.highlight then
		local hl = Instance.new("Highlight")
		hl.Name = "PotentNpcHighlight"
		hl.FillColor = NPC_HIGHLIGHT_FILL
		hl.OutlineColor = NPC_HIGHLIGHT_OUTLINE
		hl.FillTransparency = 0.6
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = npc
		hl.Enabled = npcEspEnabled
		hl.Parent = npc
		data.highlight = hl
	end

	if npcTracerEnabled and not data.tracer then
		data.tracer = createTracer()
	end

	if npcNameEnabled and not data.nameTag then
		data.nameTag = createNameTag()
		data.nameTag.Text = getNpcDisplayName(npc)
	end
end

local function removeNpcEsp(npc)
	local data = trackedNpcs[npc]
	if not data then return end
	if data.highlight then
		pcall(function() data.highlight:Destroy() end)
	end
	if data.tracer then
		pcall(function() data.tracer:Remove() end)
	end
	if data.nameTag then
		pcall(function() data.nameTag:Remove() end)
	end
	trackedNpcs[npc] = nil
end

local function applyNpcEspState()
	for npc, data in pairs(trackedNpcs) do
		if npcHighlightEnabled and not data.highlight then
			local hl = Instance.new("Highlight")
			hl.Name = "PotentNpcHighlight"
			hl.FillColor = NPC_HIGHLIGHT_FILL
			hl.OutlineColor = NPC_HIGHLIGHT_OUTLINE
			hl.FillTransparency = 0.6
			hl.OutlineTransparency = 0
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.Adornee = npc
			hl.Enabled = npcEspEnabled
			hl.Parent = npc
			data.highlight = hl
		end
		if data.highlight then
			data.highlight.Enabled = npcEspEnabled and npcHighlightEnabled
		end

		if npcTracerEnabled and not data.tracer then
			data.tracer = createTracer()
		end
		if data.tracer and not (npcEspEnabled and npcTracerEnabled) then
			data.tracer.Visible = false
		end

		if npcNameEnabled and not data.nameTag then
			data.nameTag = createNameTag()
			data.nameTag.Text = getNpcDisplayName(npc)
		end
		if data.nameTag and not (npcEspEnabled and npcNameEnabled) then
			data.nameTag.Visible = false
		end
	end
end

local function scanNpcEsp()
	local seen = {}

	for _, d in ipairs(workspaceService:GetDescendants()) do
		if d:IsA("Model") and isNpc(d) then
			seen[d] = true
			ensureNpcEsp(d)
		end
	end

	for npc in pairs(trackedNpcs) do
		if not seen[npc] or not npc.Parent then
			removeNpcEsp(npc)
		end
	end

	local count = 0
	for _ in pairs(trackedNpcs) do count = count + 1 end
	if npcCountLabel then npcCountLabel.Text = tostring(count) end
end

local function updateTracers()
	if not npcEspEnabled then return end

	local camera = workspaceService.CurrentCamera
	if not camera then return end
	local viewport = camera.ViewportSize
	local origin = Vector2.new(viewport.X / 2, viewport.Y - 40)

	for npc, data in pairs(trackedNpcs) do
		if npcTracerEnabled and data.tracer then
			local line = data.tracer
			if npc.Parent then
				local hrp = getNpcAnchor(npc)
				if hrp then
					local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
					if onScreen then
						line.From = origin
						line.To = Vector2.new(screenPos.X, screenPos.Y)
						line.Visible = true
					else
						line.Visible = false
					end
				else
					line.Visible = false
				end
			else
				line.Visible = false
			end
		end

		if npcNameEnabled and data.nameTag then
			local tag = data.nameTag
			if npc.Parent then
				local topPos = getNpcHeadTop(npc)
				if topPos then
					local screenPos, onScreen = camera:WorldToViewportPoint(topPos)
					if onScreen then
						tag.Position = Vector2.new(screenPos.X, screenPos.Y)
						local currentName = getNpcDisplayName(npc)
						if tag.Text ~= currentName then
							tag.Text = currentName
						end
						tag.Visible = true
					else
						tag.Visible = false
					end
				else
					tag.Visible = false
				end
			else
				tag.Visible = false
			end
		end
	end
end

-- Totem ESP ---------------------------------------------------------------

local function isTotem(instance)
	if not (instance:IsA("Model") or instance:IsA("BasePart")) then
		return false
	end
	return instance.Name:lower():find(TOTEM_NAME_PATTERN, 1, true) ~= nil
end

local function ensureTotemEsp(totem)
	if not trackedTotems[totem] then
		local hl = Instance.new("Highlight")
		hl.Name = "PotentTotemHighlight"
		hl.FillColor = TOTEM_HIGHLIGHT_FILL
		hl.OutlineColor = TOTEM_HIGHLIGHT_OUTLINE
		hl.FillTransparency = 0.5
		hl.OutlineTransparency = 0
		hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		hl.Adornee = totem
		hl.Enabled = totemEspEnabled
		hl.Parent = totem
		trackedTotems[totem] = hl
	end
end

local function removeTotemEsp(totem)
	local hl = trackedTotems[totem]
	if hl then hl:Destroy() end
	trackedTotems[totem] = nil
end

local function scanTotems()
	local seen = {}
	for _, d in ipairs(workspaceService:GetDescendants()) do
		if isTotem(d) then
			seen[d] = true
			ensureTotemEsp(d)
		end
	end
	for totem in pairs(trackedTotems) do
		if not seen[totem] or not totem.Parent then
			removeTotemEsp(totem)
		end
	end
	for _, hl in pairs(trackedTotems) do
		hl.Enabled = totemEspEnabled
	end
end

-- Fast travel ---------------------------------------------------------------

local function nameMatchesFastTravel(name)
	local lower = name:lower()
	for _, hint in ipairs(FAST_TRAVEL_GUI_HINTS) do
		if lower:find(hint, 1, true) then
			return true
		end
	end
	return false
end

local function revealFastTravelGui()
	local playerGui = getPlayerGui()
	if not playerGui then return false end
	local revealed = false
	for _, d in ipairs(playerGui:GetDescendants()) do
		if d:IsA("ScreenGui") or d:IsA("Folder") or d:IsA("Frame") then
			if nameMatchesFastTravel(d.Name) then
				if d:IsA("ScreenGui") then
					pcall(function() d.Enabled = true end)
					revealed = true
				end
				if d:IsA("GuiObject") then
					local node = d
					while node and node ~= playerGui do
						if node:IsA("GuiObject") then
							pcall(function() node.Visible = true end)
						end
						node = node.Parent
					end
					revealed = true
				end
			end
		end
	end
	return revealed
end

local function fireWaypointPrompt()
	local waypointRoot = resolvePath(workspaceService, WAYPOINT_ROOT)
	if not waypointRoot then return false end
	for _, d in ipairs(waypointRoot:GetDescendants()) do
		if d:IsA("ProximityPrompt") then
			local ok = pcall(function()
				d.Enabled = true
				d.MaxActivationDistance = math.huge
				d.HoldDuration = 0
				fireproximityprompt(d)
			end)
			if ok then return true end
		end
	end
	return false
end

local function fireWaypointClick()
	local waypointRoot = resolvePath(workspaceService, WAYPOINT_ROOT)
	if not waypointRoot then return false end
	for _, d in ipairs(waypointRoot:GetDescendants()) do
		if d:IsA("ClickDetector") then
			local ok = pcall(function()
				d.MaxActivationDistance = math.huge
				fireclickdetector(d, math.huge, "MouseClick")
			end)
			if ok then return true end
		end
	end
	return false
end

local function openFastTravel()
	if revealFastTravelGui() then return true, "revealed UI" end
	if fireWaypointPrompt() then return true, "fired waypoint prompt" end
	if fireWaypointClick() then return true, "fired click detector" end
	return false, "no method worked"
end

-- Auto jump ---------------------------------------------------------------

local function isOnGround(humanoid)
	return humanoid.FloorMaterial ~= Enum.Material.Air
end

local function tryJump(humanoid)
	if not isOnGround(humanoid) then return end
	pcall(function() humanoid.Jump = true end)
	task.wait(0.05)
	local state = humanoid:GetState()
	if state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.Freefall
	then
		pcall(function()
			humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
		end)
	end
end

local function runJumpTick()
	if not autoJump then return end
	local character = localPlayer.Character
	if not character then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local state = humanoid:GetState()
	if state == Enum.HumanoidStateType.Jumping
		or state == Enum.HumanoidStateType.Freefall
		or state == Enum.HumanoidStateType.Swimming
		or state == Enum.HumanoidStateType.Climbing
		or state == Enum.HumanoidStateType.Dead
	then
		return
	end
	pcall(tryJump, humanoid)
end

-- UI helpers ----------------------------------------------------------------

local function makeCorner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius)
	c.Parent = parent
	return c
end

local function makeStroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	s.Color = color
	s.Thickness = thickness or 1
	s.Transparency = transparency or 0.5
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Parent = parent
	return s
end

local function makeLabel(parent, text, size, position, bold, textColor, textSize, alignment)
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = size
	label.Position = position
	label.Font = bold and FONT_BOLD or FONT
	label.Text = text
	label.TextColor3 = textColor or C.text
	label.TextSize = textSize or 13
	label.TextXAlignment = alignment or Enum.TextXAlignment.Left
	label.TextYAlignment = Enum.TextYAlignment.Center
	label.Parent = parent
	return label
end

